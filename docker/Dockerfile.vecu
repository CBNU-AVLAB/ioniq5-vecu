# @file      Dockerfile.vecu
# @brief     IONIQ5 vECU container image (Target ECU, headless)
#
# @date      2026-06-24 created by Junhyeok Seo (jun2342@chungbuk.ac.kr)

# Build context: the project root (see docker/docker-compose.yml).
FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY src/ ./src/
COPY dbc/ ./dbc/
COPY LICENSE.txt ./

ENV PYTHONPATH=/app/src \
    PYTHONUNBUFFERED=1

# vcan0 and the manual-input UDP port (127.0.0.1:47100) are shared with the host (network_mode: host).
CMD ["python", "-m", "ioniq5_vecu.vecu", "--channel", "vcan0"]
